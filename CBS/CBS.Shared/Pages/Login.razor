@page "/"
@page "/login"
@layout EmptyLayout
@inject NavigationManager NavManager
@inject CBS.Shared.Services.AdminStateService AdminService

<PageTitle>Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="d-flex justify-center align-center" Style="height:100vh;">
    <MudPaper Elevation="4" Class="pa-6" Style="width:400px;">

        <div class="d-flex justify-center mb-4">
            <MudAvatar Size="Size.Large" Image="images/logo.png" />
        </div>

        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">Login</MudText>

        <MudTextField @bind-Value="_username" Label="Username" Variant="Variant.Outlined"
                      Immediate="true" Required="true" Class="mb-4"
                      @onkeydown="OnKeyDown" />
        <MudTextField @bind-Value="_password" Label="Password" Variant="Variant.Outlined"
                      InputType="InputType.Password" Immediate="true" Required="true" Class="mb-4"
                      @onkeydown="OnKeyDown" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleLogin" FullWidth="true">
            Login
        </MudButton>

        @if (!string.IsNullOrEmpty(_message))
        {
            <MudAlert Severity="@_severity" Class="mt-4">@_message</MudAlert>
        }
    </MudPaper>
</MudContainer>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _message  = string.Empty;
    private Severity _severity = Severity.Error;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HandleLogin();
    }

    private void HandleLogin()
    {
        var admin = AdminService.FindByUsername(_username);
        if (admin is not null && admin.IsActive && admin.PasswordHash == _password)
        {
            _severity = Severity.Success;
            _message  = "Login successful!";
            NavManager.NavigateTo("/financial-report", forceLoad: true);
        }
        else
        {
            _severity = Severity.Error;
            _message  = "Invalid username or password.";
        }
    }
}
