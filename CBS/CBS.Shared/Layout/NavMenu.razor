@inject IDialogService DialogService

<div class="nav-root">

    <!-- Top nav links -->
    <div class="nav-links">

        <div class="nav-section-label">Overview</div>
        <MudNavLink Href="/financial-report" Icon="@Icons.Material.Filled.Leaderboard"
                    Match="NavLinkMatch.All" Class="menu-item">
            Financial Report
        </MudNavLink>

        <div class="nav-section-label">Records</div>
        <MudNavLink Href="/contributions" Icon="@Icons.Material.Filled.Savings"
                    Match="NavLinkMatch.All" Class="menu-item">
            Contributions
        </MudNavLink>
        <MudNavLink Href="/vendors" Icon="@Icons.Material.Filled.Storefront"
                    Match="NavLinkMatch.All" Class="menu-item">
            Vendors
        </MudNavLink>
        <MudNavLink Href="/expenses" Icon="@Icons.Material.Filled.Receipt"
                    Match="NavLinkMatch.All" Class="menu-item">
            Expenses
        </MudNavLink>
        <MudNavLink Href="/members" Icon="@Icons.Material.Filled.Group"
                    Match="NavLinkMatch.All" Class="menu-item">
            Members
        </MudNavLink>

        <div class="nav-section-label">Administration</div>
        <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.ManageAccounts"
                    Match="NavLinkMatch.All" Class="menu-item">
            Account
        </MudNavLink>
        <MudNavLink OnClick="CreateAdmin" Icon="@Icons.Material.Filled.PersonAdd"
                    Match="NavLinkMatch.All" Class="menu-item">
            Create Admin
        </MudNavLink>

    </div>

    <!-- Footer -->
    <div class="nav-footer">
        <MudDivider Class="mb-3" />
        <div class="nav-footer-brand">
            <img src="_content/CBS.Shared/images/logo.svg?v=2" style="width:22px;height:22px;" alt="CBS" />
            <span class="nav-footer-name">CBS</span>
        </div>
        <div class="nav-footer-sub">Church Budgeting System</div>
        <div class="nav-footer-sub">LAMI Church · v1.0</div>
    </div>

</div>

@code {
    private void CreateAdmin()
    {
        _ = DialogService.ShowAsync<CBS.Shared.Pages.Admin.CreateAdminDialog>("Create Admin Account");
    }
}

<style>
    .nav-root {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 12px 16px 16px;
        box-sizing: border-box;
    }

    .nav-links {
        flex: 1;
        overflow-y: auto;
    }

    .nav-section-label {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: #90A4AE;
        padding: 18px 8px 6px;
    }

    .nav-section-label:first-child {
        padding-top: 8px;
    }

    .menu-item:hover {
        color: var(--mud-palette-primary) !important;
        font-weight: bold;
        background-color: var(--mud-palette-action-default-hover) !important;
        border-radius: 4px;
        transition: background-color 0.2s ease;
    }
    .menu-item.active {
        color: white !important;
        background-color: var(--mud-palette-primary) !important;
        border-radius: 4px;
    }

    .nav-footer {
        flex-shrink: 0;
        padding-top: 8px;
    }

    .nav-footer-brand {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

    .nav-footer-name {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 2px;
        color: var(--mud-palette-text-primary);
    }

    .nav-footer-sub {
        font-size: 10px;
        color: #90A4AE;
        line-height: 1.6;
        padding-left: 30px;
    }
</style>
