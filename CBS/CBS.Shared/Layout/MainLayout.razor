@inherits LayoutComponentBase
@inject NavigationManager NavManager
@inject CBS.Shared.Services.VendorStateService VendorService
@inject CBS.Shared.Services.MemberStateService MemberService
@inject CBS.Shared.Services.ContributionStateService ContributionService
@inject CBS.Shared.Services.ExpenseStateService ExpenseService
@inject CBS.Shared.Services.AdminStateService AdminService
@inject IDialogService DialogService
@implements IDisposable
@using CBS.Shared.Services
@using CBS.Shared.Pages.Admin
@using CBS.Shared.Pages.Members
@using CBS.Shared.Pages.Expenses
@using CBS.Shared.Pages.Contributions
@using CBS.Shared.Pages.Vendors

<MudThemeProvider Theme="_currentTheme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Style="@AppBarStyle">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="DrawerToggle" />

        <!-- CBS Logo -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="ml-1">
            <img src="_content/CBS.Shared/images/logo.svg?v=2" style="width:32px;height:32px;" alt="CBS" />
            <MudText Typo="Typo.h6" Style="font-family:'Poppins',sans-serif;font-weight:700;letter-spacing:2.5px;color:inherit;font-size:17px;">CBS</MudText>
        </MudStack>

        <MudSpacer />

        <!-- Global command-palette search -->
        <div style="position:relative; width:44%; min-width:280px; max-width:520px;">
            <MudTextField Value="@_searchString"
                          ValueChanged="@((string v) => OnSearchChanged(v))"
                          Immediate="true"
                          @onfocus="OnSearchFocus"
                          @onblur="OnSearchBlur"
                          @onkeydown="OnSearchKeyDown"
                          Placeholder="Search members, expenses, vendors…  ⌘K"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AdornmentColor="Color.Primary"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="gsd-input mt-0" />

            @if (_showSearch && _searchResults.Count > 0)
            {
                var flat = _searchResults;
                <div class="gsd-dropdown">
                    @foreach (var group in flat.GroupBy(r => r.Category))
                    {
                        <div class="gsd-category">
                            <span class="gsd-category-dot" style="background:@CategoryColor(group.Key);"></span>
                            @group.Key
                        </div>
                        @foreach (var item in group)
                        {
                            var idx = flat.IndexOf(item);
                            <div class="gsd-item @(idx == _activeIndex ? "gsd-item-active" : "")"
                                 @onmousedown="@(async () => await ActivateResult(item))">
                                <div class="gsd-icon-wrap" style="background:@CategoryColor(item.Category)1A; color:@CategoryColor(item.Category);">
                                    <MudIcon Icon="@item.Icon" Size="Size.Small" />
                                </div>
                                <div class="gsd-text">
                                    <div class="gsd-label">@item.Label</div>
                                    @if (!string.IsNullOrEmpty(item.Sub))
                                    {
                                        <div class="gsd-sub">@item.Sub</div>
                                    }
                                </div>
                                <span class="gsd-badge" style="background:@CategoryColor(item.Category)1A; color:@CategoryColor(item.Category);">
                                    @(item.Action is not null ? item.Badge : "↗")
                                </span>
                            </div>
                        }
                    }
                    <div class="gsd-hint">
                        <span>↑↓ navigate</span>
                        <span>↵ select</span>
                        <span>Esc close</span>
                    </div>
                </div>
            }
        </div>

        <MudSpacer />

        <!-- User menu -->
        <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mr-1"
                   Style="font-size:12px; font-weight:700; font-family:'Poppins',sans-serif;">GR</MudAvatar>
        <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Variant="Variant.Text" Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Size="Size.Small" Class="mr-2">
            <ChildContent>
                <MudMenuItem AutoClose="false">
                    <div class="d-flex align-center w-100" style="gap:12px;">
                        <MudIcon Icon="@(_isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)" />
                        <MudText>Dark Mode</MudText>
                        <MudSpacer />
                        <MudSwitch @bind-Value="_isDarkMode" Color="Color.Primary" T="bool" />
                    </div>
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="@(() => HandleAction("Logout"))" IconColor="Color.Error">
                    <MudText Color="Color.Error">Logout</MudText>
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-5 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
    /* ── Search input ── */
    .gsd-input .mud-input-root,
    .gsd-input .mud-input-outlined-border { border-radius: 10px !important; }
    .gsd-input .mud-input-root { font-size: 13.5px !important; }

    /* ── Search dropdown ── */
    .gsd-dropdown {
        position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 9999;
        background: var(--mud-palette-surface, #fff);
        border: 1px solid rgba(0,0,0,0.09); border-radius: 14px;
        box-shadow: 0 16px 48px rgba(0,0,0,0.16), 0 2px 8px rgba(0,0,0,0.08);
        overflow: hidden;
        animation: dropIn 0.15s cubic-bezier(0.22,1,0.36,1);
    }
    .gsd-category {
        display: flex; align-items: center; gap: 6px;
        font-size: 10px; font-weight: 700; text-transform: uppercase;
        letter-spacing: 1.2px; color: #94A3B8; padding: 10px 14px 5px;
        border-top: 1px solid rgba(0,0,0,0.05);
    }
    .gsd-category:first-of-type { border-top: none; }
    .gsd-category-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }

    .gsd-item {
        display: flex; align-items: center; gap: 10px; padding: 8px 12px;
        cursor: pointer; transition: background 0.1s ease; margin: 1px 6px; border-radius: 8px;
    }
    .gsd-item:hover,
    .gsd-item-active { background: rgba(37,99,235,0.07); }

    .gsd-icon-wrap {
        width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
    }
    .gsd-text { flex: 1; min-width: 0; }
    .gsd-label { font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .gsd-sub   { font-size: 11px; color: #94A3B8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 1px; }
    .gsd-badge {
        font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 6px;
        white-space: nowrap; flex-shrink: 0; font-family: 'Inter', sans-serif; letter-spacing: 0.3px;
    }
    .gsd-hint {
        display: flex; gap: 14px; padding: 8px 14px;
        border-top: 1px solid rgba(0,0,0,0.06); background: rgba(0,0,0,0.02);
        font-size: 10px; color: #94A3B8; font-weight: 500;
    }

    /* ── Misc overrides ── */
    .mud-button-root { transition: transform 0.1s ease, box-shadow 0.15s ease, background-color 0.15s ease !important; }
    .mud-button-root:hover  { transform: translateY(-1px); }
    .mud-button-root:active { transform: translateY(0); }
    .mud-icon-button { transition: background-color 0.15s ease, transform 0.1s ease !important; }
    .mud-nav-link    { transition: background-color 0.15s ease, color 0.15s ease !important; border-radius: 8px !important; }
</style>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;

    private string AppBarStyle => _isDarkMode
        ? "background:rgba(15,23,42,0.92)!important; border-bottom:1px solid rgba(255,255,255,0.06)!important; box-shadow:0 1px 12px rgba(0,0,0,0.4)!important; backdrop-filter:blur(16px) saturate(180%)!important; -webkit-backdrop-filter:blur(16px) saturate(180%)!important;"
        : "background:rgba(255,255,255,0.88)!important; border-bottom:1px solid rgba(0,0,0,0.07)!important; box-shadow:0 1px 12px rgba(0,0,0,0.06)!important; backdrop-filter:blur(16px) saturate(180%)!important; -webkit-backdrop-filter:blur(16px) saturate(180%)!important;";
    private string _searchString = string.Empty;
    private bool _showSearch = false;
    private int _activeIndex = -1;
    private List<SearchResult> _searchResults = new();

    private sealed class SearchResult
    {
        public string     Category { get; init; } = "";
        public string     Label    { get; init; } = "";
        public string     Sub      { get; init; } = "";
        public string?    Path     { get; init; }
        public string     Icon     { get; init; } = "";
        public string     Badge    { get; init; } = "↗";
        public Func<Task>? Action  { get; init; }
    }

    private static string CategoryColor(string cat) => cat switch
    {
        "Members"       => "#2563EB",
        "Vendors"       => "#7C3AED",
        "Expenses"      => "#EA580C",
        "Contributions" => "#059669",
        "Quick Actions" => "#0EA5E9",
        _               => "#64748B"
    };

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
        if (NavManager.Uri.EndsWith("/"))
            NavManager.NavigateTo("/login", true);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => await InvokeAsync(StateHasChanged);

    public void Dispose() => NavManager.LocationChanged -= OnLocationChanged;

    // ── Global search ──────────────────────────────────────────────────────

    private void OnSearchChanged(string value)
    {
        _searchString = value ?? string.Empty;
        _activeIndex  = -1;
        _searchResults = BuildResults(_searchString);
        _showSearch = _searchResults.Count > 0;
    }

    private void OnSearchFocus()
    {
        if (_searchResults.Count > 0) _showSearch = true;
    }

    private async Task OnSearchBlur()
    {
        await Task.Delay(200);
        _showSearch = false;
        _activeIndex = -1;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (!_showSearch) return;
        switch (e.Key)
        {
            case "ArrowDown":
                _activeIndex = Math.Min(_activeIndex + 1, _searchResults.Count - 1);
                break;
            case "ArrowUp":
                _activeIndex = Math.Max(_activeIndex - 1, 0);
                break;
            case "Enter" when _activeIndex >= 0:
                await ActivateResult(_searchResults[_activeIndex]);
                break;
            case "Escape":
                _showSearch  = false;
                _activeIndex = -1;
                break;
        }
    }

    private async Task ActivateResult(SearchResult item)
    {
        _showSearch    = false;
        _searchString  = string.Empty;
        _activeIndex   = -1;
        _searchResults.Clear();

        if (item.Action is not null)
            await item.Action();
        else if (item.Path is not null)
            NavManager.NavigateTo(item.Path);
    }

    private List<SearchResult> BuildResults(string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return new();
        var q    = query.Trim();
        var list = new List<SearchResult>();

        // ── Quick actions (type "add …") ───────────────────────────
        var actions = new (string Name, string Icon, Func<Task> Action)[]
        {
            ("Add Member",       Icons.Material.Filled.PersonAdd,   async () => await DialogService.ShowAsync<AddMemberDialog>("Add Member")),
            ("Add Contribution", Icons.Material.Filled.Savings,     async () => await DialogService.ShowAsync<AddContributionDialog>("Add Contribution")),
            ("Add Expense",      Icons.Material.Filled.ReceiptLong, async () => await DialogService.ShowAsync<AddExpenseDialog>("Add Expense")),
        };
        list.AddRange(actions
            .Where(a => a.Name.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Select(a => new SearchResult
            {
                Category = "Quick Actions",
                Label    = a.Name,
                Sub      = "Open dialog",
                Icon     = a.Icon,
                Badge    = "→",
                Action   = a.Action
            }));

        // ── Pages ─────────────────────────────────────────────────
        (string Name, string Path, string Icon)[] pages =
        {
            ("Financial Report", "/financial-report", Icons.Material.Filled.Leaderboard),
            ("Contributions",    "/contributions",    Icons.Material.Filled.Savings),
            ("Vendors",          "/vendors",          Icons.Material.Filled.Storefront),
            ("Expenses",         "/expenses",         Icons.Material.Filled.Receipt),
            ("Members",          "/members",          Icons.Material.Filled.Group),
        };
        list.AddRange(pages
            .Where(p => p.Name.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Select(p => new SearchResult
            {
                Category = "Pages",
                Label    = p.Name,
                Sub      = p.Path,
                Path     = p.Path,
                Icon     = p.Icon
            }));

        // ── Members → open contribution history directly ───────────
        list.AddRange(MemberService.Members
            .Where(m => m.FullName.Contains(q, StringComparison.OrdinalIgnoreCase) || m.Id.ToString() == q)
            .Take(5)
            .Select(m =>
            {
                var count = ContributionService.Contributions.Count(c => c.MemberId == m.Id);
                var total = ContributionService.Contributions.Where(c => c.MemberId == m.Id).Sum(c => c.Amount);
                return new SearchResult
                {
                    Category = "Members",
                    Label    = m.FullName,
                    Sub      = $"{m.Area}  ·  {count} contribution{(count == 1 ? "" : "s")}  ·  PHP {total:N2}",
                    Icon     = Icons.Material.Filled.Person,
                    Badge    = "Contributions",
                    Action   = async () =>
                    {
                        var p = new DialogParameters
                        {
                            ["MemberId"]   = m.Id,
                            ["MemberName"] = m.FullName
                        };
                        await DialogService.ShowAsync<ViewMemberContributionsDialog>($"Contributions ({count})", p);
                    }
                };
            }));

        // ── Vendors ────────────────────────────────────────────────
        list.AddRange(VendorService.Vendors
            .Where(v => v.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                        (!string.IsNullOrEmpty(v.Address) && v.Address.Contains(q, StringComparison.OrdinalIgnoreCase)))
            .Take(4)
            .Select(v => new SearchResult
            {
                Category = "Vendors",
                Label    = v.Name,
                Sub      = v.Address,
                Path     = $"/vendors/{v.Id}/transactions",
                Icon     = Icons.Material.Filled.Storefront
            }));

        // ── Expenses ───────────────────────────────────────────────
        list.AddRange(ExpenseService.Expenses
            .Where(e => e.Description.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                        VendorService.GetName(e.VendorId).Contains(q, StringComparison.OrdinalIgnoreCase))
            .Take(4)
            .Select(e => new SearchResult
            {
                Category = "Expenses",
                Label    = e.Description,
                Sub      = $"PHP {e.Amount:N2}  ·  {VendorService.GetName(e.VendorId)}  ·  {e.ExpenseDate:MMM dd, yyyy}",
                Path     = "/expenses",
                Icon     = Icons.Material.Filled.Receipt
            }));

        // ── Contributions by member name ───────────────────────────
        list.AddRange(ContributionService.Contributions
            .Where(c => MemberService.GetFullName(c.MemberId).Contains(q, StringComparison.OrdinalIgnoreCase))
            .Take(4)
            .Select(c =>
            {
                var name = MemberService.GetFullName(c.MemberId);
                return new SearchResult
                {
                    Category = "Contributions",
                    Label    = name,
                    Sub      = $"PHP {c.Amount:N2}  ·  {c.ContributionType}  ·  {c.ContributionDate:MMM dd, yyyy}",
                    Path     = "/contributions",
                    Icon     = Icons.Material.Filled.Savings
                };
            }));

        return list;
    }

    // ── Theme ───────────────────────────────────────────────────────────

    private MudTheme _currentTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary          = "#2563EB",
            Secondary        = "#10B981",
            Tertiary         = "#F59E0B",
            AppbarBackground = "rgba(255,255,255,0.88)",
            AppbarText       = "#1E293B",
            Background       = "#F8FAFC",
            Surface          = "#FFFFFF",
            TextPrimary      = "#1E293B",
            TextSecondary    = "#64748B",
            DrawerBackground = "#FFFFFF",
            DrawerText       = "#1E293B",
            ActionDefault    = "#64748B",
            Divider          = "rgba(0,0,0,0.08)"
        },
        PaletteDark = new PaletteDark
        {
            Primary          = "#60A5FA",
            Secondary        = "#34D399",
            AppbarBackground = "rgba(15,23,42,0.88)",
            AppbarText       = "#E2E8F0",
            Background       = "#0F172A",
            Surface          = "#1E293B",
            TextPrimary      = "#E2E8F0",
            TextSecondary    = "#94A3B8",
            DrawerBackground = "#1E293B",
            DrawerText       = "#E2E8F0",
            ActionDefault    = "#94A3B8",
            Divider          = "rgba(255,255,255,0.08)"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "8px", DrawerWidthLeft = "230px" }
    };

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private void HandleAction(string item)
    {
        if (item == "Logout") NavManager.NavigateTo("/");
    }
}
