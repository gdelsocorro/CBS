<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/CBS.Shared/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="_content/CBS.Shared/app.css" />
    <link rel="stylesheet" href="CBS.Web.styles.css" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="_content/CBS.Shared/images/logo.svg?v=2" />
    <link rel="icon" type="image/png" href="_content/CBS.Shared/favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>

    <!-- Loading screen -->
    <div id="cbs-loader">
        <div class="cbs-loader-inner">
            <img src="_content/CBS.Shared/images/logo.svg?v=2" class="cbs-loader-logo" alt="CBS" />
            <div class="cbs-loader-title">CBS</div>
            <div class="cbs-loader-dots">
                <span></span><span></span><span></span>
            </div>
        </div>
    </div>

    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/CBS.Shared/js/cbs-utils.js"></script>
</body>

</html>
